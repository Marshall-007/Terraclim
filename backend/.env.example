PORT=8000
DEMO_DATE=2026-01-20
TERRACLIM_TOKEN=
# AI Insights rephrase layer (optional). Blank AI_KEY = deterministic templates only.
# AI_BASE_URL is any OpenAI-compatible endpoint; the default targets api.openai.com.
AI_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
CACHE_TTL_HOURS=6
# Optional: force a provider (open-meteo | terraclim | datapack). Blank = auto-select
# (datapack if loaded -> terraclim if ready -> open-meteo). The Settings panel sets this at runtime.
VINO_PROVIDER=
